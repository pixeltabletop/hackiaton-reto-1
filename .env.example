# Copia este archivo a .env.local y completa los valores reales.
# NUNCA subas .env.local ni el token real al repositorio (ya están en .gitignore).

# Integración interna de Notion (notion.so/my-integrations)
NOTION_TOKEN=

# IDs de las fuentes de datos (data sources) que crea `npm run notion:preparar`
NOTION_FUENTE_CASOS=
NOTION_FUENTE_POLIZAS=
NOTION_FUENTE_DECISIONES=
