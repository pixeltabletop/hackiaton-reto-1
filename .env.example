# Copia este archivo a .env.local y completa los valores reales.
# NUNCA subas .env.local ni el token real al repositorio (ya están en .gitignore).

# Modelo que lee los informes. Basta con UNA clave; si hay varias, gana la primera de esta lista.
# Antes de publicar con cualquiera, correr: npm run probar:proveedor
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
# Opcional: otro modelo del proveedor elegido
MODELO_LECTURA=

# Integración interna de Notion (notion.so/my-integrations)
NOTION_TOKEN=

# IDs de las fuentes de datos (data sources) que crea `npm run notion:preparar`
NOTION_FUENTE_CASOS=
NOTION_FUENTE_POLIZAS=
NOTION_FUENTE_DECISIONES=
